{
  "name": "@sso-info/sdk",
  "version": "0.3.0",
  "description": "OIDC 单点登录浏览器 SDK：弹出窗口登录并通过 postMessage 取回用户信息（零依赖）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FantasyIT-Projects/sso_info_getter_sdk.git"
  },
  "homepage": "https://github.com/FantasyIT-Projects/sso_info_getter_sdk#readme",
  "bugs": {
    "url": "https://github.com/FantasyIT-Projects/sso_info_getter_sdk/issues"
  }
}
